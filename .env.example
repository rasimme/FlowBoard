# FlowBoard Dashboard — Environment Variables
# Copy to .env or set via systemd drop-in (see templates/systemd-auth.conf.example)

# Workspace path (where projects/ lives)
OPENCLAW_WORKSPACE=/path/to/.openclaw/workspace

# Gateway webhook (for project-switch wake events)
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_HOOKS_TOKEN=

# --- Telegram Mini App Auth (optional) ---
# Without these, the dashboard runs without authentication (local access only)

TELEGRAM_BOT_TOKEN=
# Additional tokens are comma-separated; do not add empty entries.
TELEGRAM_BOT_TOKENS=
# Same count/order as primary + additional tokens; every agent ID must be unique.
FLOWBOARD_TELEGRAM_AGENT_IDS=
JWT_SECRET=
ALLOWED_USER_IDS=
DASHBOARD_ORIGIN=

# Set to "true" if using a non-Cloudflare tunnel (ngrok, Tailscale, etc.)
# AUTH_ALWAYS=true

# Optional trusted proxy/tunnel peer addresses for rate-limit client IPs.
# For local cloudflared, use only when its loopback listener is trusted.
# Empty keeps the fail-safe transport-socket key.
# FLOWBOARD_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Self-Update Safety (T-417-6) — Enable in-dashboard updates via POST /api/update/run
# Defaults to false (disabled) for safety; operators should use: node scripts/setup.mjs --update
# FLOWBOARD_ENABLE_SELF_UPDATE=true
